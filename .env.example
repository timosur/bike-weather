DATABASE_URL=postgresql+asyncpg://bike:bike@localhost:5432/bikeweather
CORS_ORIGINS=["http://localhost:5173","https://bike-weather.com","https://fahrrad-wetter.com"]
AUTHENTIK_ISSUER_URL=http://localhost:9000/application/o/bike-weather/
AUTHENTIK_AUDIENCE=bike-weather
AUTHENTIK_SECRET_KEY=change-me-to-a-long-random-string
AUTHENTIK_BASE_URL=http://localhost:9000
AUTHENTIK_API_TOKEN=placeholder-run-make-auth-setup
AUTHENTIK_CLIENT_ID=bike-weather
FRONTEND_URL=http://localhost:5173
# FRONTEND_URL is used for headless OIDC redirect_uri; set to primary domain in production.
# Both domains (bike-weather.com + fahrrad-wetter.com) are registered as redirect URIs in Authentik.
VITE_AUTHENTIK_URL=http://localhost:9000/application/o/bike-weather/
VITE_AUTHENTIK_CLIENT_ID=bike-weather
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false

# SMTP (Authentik email delivery for password reset etc.)
AUTHENTIK_EMAIL__HOST=smtp.gmail.com
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__FROM=noreply@bike-weather.com

# Google Maps Platform (Geocoding)
GOOGLE_MAPS_API_KEY=